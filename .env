PORT=3000

# MongoDB — only ONE MONGO_URI may be uncommented. dotenv keeps the last
# occurrence, so a duplicate silently overrides the line above it.

# Local development: reach the database server over the network.
#MONGO_URI=mongodb://admin:ArunDev%40123@148.113.9.103:27017/?authSource=admin

# Production: the app runs on the same host as MongoDB, so it connects over loopback.
MONGO_URI=mongodb://admin:ArunDev%40123@127.0.0.1:27017/?authSource=admin

MONGO_DB_NAME=crawlit
REDIS_URL=redis://127.0.0.1:6379
REFRESH_INTERVAL_MS=1800000

# Queue dashboard at /admin/queues. Leave unset to keep it disabled.
ADMIN_USER=admin
ADMIN_PASS=change-this-password

EARNKARO_API_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJfaWQiOiI2YTkzMGQzY2ZhNjMxOWMyMmU4NWFkMGEiLCJlYXJua2FybyI6IjU1ODUzMzUiLCJpYXQiOjE3ODgwMzAyODZ9.NCFgIOar67eyATm_1dzNX8f0IZWsv1G1TsEy_OqLXMg
EARNKARO_CONVERT_OPTION=convert_only