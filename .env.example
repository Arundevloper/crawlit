PORT=3000

# MongoDB — only ONE MONGO_URI may be uncommented. dotenv keeps the last
# occurrence, so a duplicate silently overrides the line above it.
# Local development points at the database host over the network; in
# production the app runs on that same host and connects over loopback.
MONGO_URI=mongodb://<user>:<password>@<host>:27017/?authSource=admin
# MONGO_URI=mongodb://<user>:<password>@127.0.0.1:27017/?authSource=admin

MONGO_DB_NAME=crawlit
REDIS_URL=redis://127.0.0.1:6379
REFRESH_INTERVAL_MS=1800000

# Queue dashboard at /admin/queues. Leave unset to keep it disabled.
ADMIN_USER=<admin-username>
ADMIN_PASS=<strong-password>
